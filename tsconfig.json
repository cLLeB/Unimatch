{
  "compilerOptions": {
    "target": "ES2023",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "types": ["node", "vite/client", "vitest/globals", "@testing-library/jest-dom"],

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // supabase/functions/_shared only. The function entrypoints use Deno globals
  // that do not exist here, and are typechecked by the Supabase CLI on deploy.
  "include": [
    "src",
    "scripts",
    "e2e",
    "vite.config.ts",
    "supabase/functions/_shared"
  ]
}
